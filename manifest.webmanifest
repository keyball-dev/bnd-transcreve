{
 "name": "BND Transcreve",
 "short_name": "Transcreve",
 "lang": "pt-BR",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "background_color": "#f6f7f9",
 "theme_color": "#1f3a5f",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any maskable"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any maskable"
  },
  {
   "src": "icon.svg",
   "sizes": "any",
   "type": "image/svg+xml"
  }
 ],
 "share_target": {
  "action": "./share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "title": "title",
   "text": "text",
   "files": [
    {
     "name": "audio",
     "accept": [
      "audio/*",
      "video/mp4",
      ".opus",
      ".ogg",
      ".oga",
      ".m4a",
      ".mp3",
      ".wav",
      ".aac",
      ".mp4"
     ]
    }
   ]
  }
 }
}